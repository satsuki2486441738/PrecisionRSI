{$NUMERICBRIDGE_INTAKE_HOST} {
	@submission {
		method POST
		path /v1/submissions
	}

	handle @submission {
		request_body {
			max_size 327680
		}
		reverse_proxy 127.0.0.1:8770
	}

	@health {
		method GET HEAD
		path /healthz
	}
	handle @health {
		reverse_proxy 127.0.0.1:8770
	}

	handle {
		respond 404
	}
}
