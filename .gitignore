# Publish the portable skill and maintainer files; keep private projects local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/CLAUDE.md
!/skills/
!/tools/
!/scripts/
/skills/*
!/skills/operator-optimize/
!/skills/framework-adapt/
!/skills/precision-compare/
!/skills/precision-repair/
!/community/
!/.github/
!/docs/
!/reports/
!/requirements-dev.txt
# Developer regressions and research stay local, outside the public repository.
/tests/
/research/
__pycache__/
*.pyc

# Historical local deliveries are not part of the results-only publication.
/community/site/evidence/deepseek41-*.zip
/community/site/evidence/paper-writing-results-*.zip
/community/site/evidence/evaluation-metrics-results-*.zip*

# GitHub contains platform configuration only. Keep generated deliveries local.
/.github/*
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE/
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/CODEOWNERS
/reports/**/*.pdf
/reports/**/*.png
/reports/**/historical-report-preserved.md
